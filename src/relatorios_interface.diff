+    def _atualizar_situacao_etapas(self, redefinir_posicao=False):
+        """Atualiza o quadro de situação (pendências, anteriores ao marco) do cliente selecionado."""
+        try:
+            nome = self.cliente_etapas.get() if getattr(self, 'cliente_etapas', None) else ''
+            if not nome:
+                self.lbl_situacao_etapas.config(text="Selecione um cliente.")
+                return
+            arquivo = self.buscar_arquivo_cliente(nome)
+            if not arquivo:
+                self.lbl_situacao_etapas.config(text="Arquivo do cliente não encontrado.")
+                return
+            self.root.config(cursor="watch")
+            self.root.update_idletasks()
+            from src.etapas_obra_core import resumo_situacao, fmt_moeda, fmt_data, fmt_pct
+            r = resumo_situacao(arquivo)
+            pct = (r['v_sem'] / r['total']) if r['total'] else 0
+            linhas = [
+                f"Sem etapa informada: {r['n_sem']} lançamentos · R$ {fmt_moeda(r['v_sem'])} ({fmt_pct(pct)} da obra)",
+                f"     mão de obra: {r['n_sem_mo']} · material, locação, serviço e diversos: {r['n_sem_outros']}",
+                f"Anteriores ao marco ({fmt_data(r['marco'])}): {r['n_ant']} lançamentos · R$ {fmt_moeda(r['v_ant'])} (fora da fila)",
+                f"Etapas em uso: {r['n_etapas']}  ·  Ordem: {r['ordem']}",
+            ]
+            if not r['gerais_cadastrada']:
+                linhas.append("ATENÇÃO: 'CUSTOS GERAIS DA OBRA' não está cadastrada na lista de etapas (Configurações).")
+            self.lbl_situacao_etapas.config(text="\n".join(linhas))
+            if redefinir_posicao or not self.var_posicao_etapas.get().strip():
+                self.var_posicao_etapas.set(fmt_data(r['ultima_data']) if r['ultima_data'] is not None else "")
+        except Exception as e:
+            logger.error(f"Erro ao atualizar situação das etapas: {str(e)}", exc_info=True)
+            self.lbl_situacao_etapas.config(text=f"Não foi possível ler a situação: {e}")
+        finally:
+            try:
+                self.root.config(cursor="")
+            except Exception:
+                pass
+
+    def processar_por_etapa(self):
+        """Gera o PDF do Relatório por Etapa da Obra na pasta do cliente."""
+        try:
+            nome = self.cliente_etapas.get() if getattr(self, 'cliente_etapas', None) else ''
+            if not nome:
+                messagebox.showwarning("Aviso", "Selecione um cliente.")
+                return
+            arquivo = self.buscar_arquivo_cliente(nome)
+            if not arquivo:
+                messagebox.showerror("Erro", f"Arquivo do cliente não encontrado: {nome}")
+                return
+            from src.etapas_obra_core import parse_data, fmt_moeda
+            posicao = self.var_posicao_etapas.get().strip() or None
+            if posicao and parse_data(posicao) is None:
+                messagebox.showwarning("Aviso", "Data de posição inválida. Use dd/mm/aaaa.")
+                return
+            self.root.config(cursor="watch")
+            self.root.update_idletasks()
+            try:
+                from src.relatorio_por_etapa import gerar_relatorio_por_etapa
+                caminho, nome_pdf, dados = gerar_relatorio_por_etapa(arquivo, posicao)
+            finally:
+                self.root.config(cursor="")
+            msg = f"Relatório gerado:\n{nome_pdf}\n\nPasta: {os.path.dirname(caminho)}"
+            if dados.sem_etapa.n:
+                msg += (f"\n\nAtenção: {dados.sem_etapa.n} lançamentos (R$ {fmt_moeda(dados.sem_etapa.total)}) "
+                        f"ainda estão sem etapa informada.")
+            for aviso in dados.avisos:
+                msg += f"\n\n{aviso}"
+            if messagebox.askyesno("Relatório gerado", msg + "\n\nDeseja abrir o PDF agora?"):
+                self.abrir_arquivo(caminho)
+            self._atualizar_situacao_etapas()
+        except PermissionError:
+            messagebox.showerror("Erro", "Não foi possível gravar o PDF. Se ele estiver aberto, feche-o e tente novamente.")
+        except Exception as e:
+            logger.error(f"Erro ao gerar relatório por etapa: {str(e)}", exc_info=True)
+            messagebox.showerror("Erro", f"Erro ao gerar o relatório por etapa:\n{str(e)}")
+
+    def processar_regularizacao_etapas(self):
+        """Abre a ferramenta de regularização de etapas (janela dedicada)."""
+        try:
+            nome = self.cliente_etapas.get() if getattr(self, 'cliente_etapas', None) else ''
+            self.root.withdraw()
+            from src.regularizacao_etapas import RegularizacaoEtapas
+            app = RegularizacaoEtapas(parent=self.root, cliente_inicial=nome or None)
+            # ao fechar a ferramenta, atualiza o quadro de situação do painel
+            app.root.bind('<Destroy>', lambda e, a=app: self.root.after(300, self._atualizar_situacao_etapas)
+                          if e.widget is a.root else None)
+        except Exception as e:
+            logger.error(f"Erro ao abrir regularização de etapas: {str(e)}", exc_info=True)
+            messagebox.showerror("Erro", f"Erro ao abrir a ferramenta:\n{str(e)}")
+            self.root.deiconify()
+
+    def abrir_ordem_marco_etapas(self):
+        """Abre o diálogo de ordem das etapas e marco de data do cliente selecionado."""
+        try:
+            nome = self.cliente_etapas.get() if getattr(self, 'cliente_etapas', None) else ''
+            if not nome:
+                messagebox.showwarning("Aviso", "Selecione um cliente.")
+                return
+            from src.regularizacao_etapas import abrir_ordem_e_marco
+            abrir_ordem_e_marco(self.root, nome, on_saved=self._atualizar_situacao_etapas)
+        except Exception as e:
+            logger.error(f"Erro ao abrir ordem e marco: {str(e)}", exc_info=True)
+            messagebox.showerror("Erro", f"Erro ao abrir ordem e marco:\n{str(e)}")
+
